[gd_resource type="Resource" script_class="SkyCyclePreset" load_steps=2 format=3]
;
; ISLAND 003's SKY (the giant foggy forest): SKYCYCLE_w2_blood_night.tres (island
; island 001's), its day turned dark and neutral, as the user asked: "if sky becomes a
; dark neutral color accompanying / complimenting the fog so the fog fades into
; it ... think dark, foggy, ancient, huge forest". The nightmare night is island
; island 001's, unchanged.
;
;   * THE HAZE is grey and dark (`day_haze_tint` 0.62): every fog here is the
;     neutral 0.30 times it, ForestFog's among them, so the fog is a dark grey —
;     and the sky's horizon, which is the haze, is the same grey, so they meet
;     without a line.
;   * THE DOME is darker still (`day_sky_top`), so the fog lightens upward into
;     nothing where island 001's sky would brighten.
;   * THE LIGHT is little and cold: a weak sun through the canopy and the fog, a
;     grey ambient, the bounce off a dark floor.

[ext_resource type="Script" path="res://scripts/SCRIPT_sky_cycle_preset.gd" id="1_preset"]

[resource]
script = ExtResource("1_preset")

day_start = 0.10
day_end = 0.60
night_start = 0.72
night_end = 0.98

day_sun_color = Color(0.86, 0.9, 0.95, 1)
day_sun_energy = 0.55
