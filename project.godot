; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GaiaSphere Demo"
config/description="A procedural floating island with rivers and a dark mere: a standalone example of the terrain and water engines."
config/version="10"
run/main_scene="res://scenes/SCENE_gaiasphere_demo.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://branding/icon.png"
; The worker pool's size, measured on the first launch and read from the second
; (scripts/SCRIPT_thread_tier.gd). A missing file is ignored.
config/project_settings_override="user://thread_tier_override.cfg"

[autoload]

CorePin="*res://scripts/autoload/AUTOLOAD_core_affinity.gd"
TerrainBake="*res://scripts/autoload/AUTOLOAD_terrain_bake.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="mobile"
occlusion_culling/use_occlusion_culling=true
limits/global_shader_variables/buffer_size=262144
scaling_3d/scale.mobile=0.5
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method.mobile="mobile"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/directional_shadow/16_bits=false
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/atlas_16_bits=false
reflections/sky_reflections/roughness_layers=4
anti_aliasing/screen_space_roughness_limiter/enabled=false
environment/glow/upscale_mode=0

[shader_globals]

enviro_light_dir={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
enviro_light_color={
"type": "color",
"value": Color(1, 1, 1, 1)
}
enviro_ambient={
"type": "color",
"value": Color(0.3, 0.3, 0.3, 1)
}
enviro_fog_color={
"type": "color",
"value": Color(0.4, 0.45, 0.5, 1)
}
enviro_wind={
"type": "vec4",
"value": Vector4(0.8, 0.6, 0.3, 0)
}
enviro_wetness={
"type": "float",
"value": 0.0
}
enviro_sky_zenith={
"type": "color",
"value": Color(0.1, 0.2, 0.5, 1)
}
enviro_sky_horizon={
"type": "color",
"value": Color(0.5, 0.6, 0.7, 1)
}
enviro_flash={
"type": "float",
"value": 0.0
}

tod_water_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
tod_haze_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
display_frame={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
; THE CRT IS ON: the post pass (shaders/SHADER_post_dither.gdshader) draws the
; picture as a tube would, tuned by the six crt_tune_* vectors below. 0.0 here
; turns it off.
crt_amount={
"type": "float",
"value": 1.0
}
crt_tune_a={
"type": "vec4",
"value": Vector4(0.048, 0.2, 3, 0)
}
crt_tune_b={
"type": "vec4",
"value": Vector4(1, 0.18, 1.2, 0.8)
}
crt_tune_c={
"type": "vec4",
"value": Vector4(1, 0.1, 9, 0.1)
}
crt_tune_d={
"type": "vec4",
"value": Vector4(6, 0.0705, 0.02, 1.3)
}
crt_tune_e={
"type": "vec4",
"value": Vector4(0, 0, 0.7, 1)
}
crt_tune_f={
"type": "vec4",
"value": Vector4(0.2, 1, 0.6, 0.8)
}
tod_art_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
tod_daylight={
"type": "float",
"value": 1.0
}
tod_env_blend={
"type": "float",
"value": 0.0
}
tod_sun_dir={
