[gd_resource type="ShaderMaterial" load_steps=3 format=3]
; ISLAND 006's water: its rivers, creeks and crater lakes, on RiverWater's surface
; (SCRIPT_river_water.gd), drawn by SHADER_river_water.gdshader (the user: "spline
; based rivers with sandy bottoms and rocky edges, and beautiful but still retro
; looking water shaders"). Jade over the deep middle, going clear and turquoise to
; the shore so the sandy bed and its caustics show, the ripples running down the
; river at the terrain's river speed, the sun glinting off them, foam on the
; riffles and along the shore. On the ground's texel grid and stepping in whole
; frames. The fog is MAT_terrain_splat_006_tropical.tres's, number for number.
; Drawn after the cloud sea (`render_priority` 1), as the fog banks and the
; blowing snow are: the sea's quad hangs under the eye and would cover it.
;
; DOWN THE HILLS IT RACES (the user: "Make water on hills much more faster moving,
; or at least appear faster moving"): RiverWater runs a reach up to five times as
; fast as flat water (`hill_speed`), and here the steepest breaks white
; (`rapids_foam`), white water racing down it at 6 m/s (`rapids_speed`), and is
; churned pale and opaque (`rapids_whiten`).

[ext_resource type="Shader" path="res://shaders/SHADER_river_water.gdshader" id="1_water"]
[ext_resource type="Texture2D" path="res://textures/TEX_tropical_water_ripples_256.png" id="2_ripples"]

; ISLAND 003 R2'S WATER (docs/DOC_island_003_r2.md): the tropics' shader
; (MAT_river_water_006_tropical.tres), every number that made that water clear
; and bright turned the other way. The user: "make the water dark, forboding,
; maybe dark green tinted, different from the tropical water".
;   * BLACK-GREEN, AND OPAQUE: the three depth colours are a dark bottle green
;     (dark, not black: at black the palette lock drops the green and the mere
;     reads as a hole), and it is nearly solid by 0.7 m (`depth_full`; 1.6 in the tropics) and
;     already three quarters so at the very edge (`alpha_shallow`), so the bed is
;     not seen through it. Peat water.
;   * SLOW AND STILL: a third of the tropics' drift, the mere barely moving, small
;     ripples.
;   * DULL: the grey sky lying on it at a low angle, a faint tight glint, almost no
;     foam, and what there is a grey-green scum rather than white.
[resource]
render_priority = 1
shader = ExtResource("1_water")
shader_parameter/ripple_tex = ExtResource("2_ripples")
shader_parameter/ripple_scale = 12.0
shader_parameter/ripple_stretch = 1.4
shader_parameter/texel_density = 21.333
shader_parameter/flow_speed = 0.5
shader_parameter/edge_speed = 0.3
shader_parameter/still_speed = 0.04
shader_parameter/flow_period = 8.0
shader_parameter/rapids_foam = 0.45
shader_parameter/rapids_whiten = 0.08
shader_parameter/rapids_speed = 6.0
shader_parameter/rapids_tile = 9.0
shader_parameter/step_rate = 12.0
shader_parameter/ripple_height = 0.05
shader_parameter/swell = 0.02
shader_parameter/deep_color = Color(0.035, 0.1, 0.055, 1)
shader_parameter/mid_color = Color(0.06, 0.16, 0.085, 1)
shader_parameter/shallow_color = Color(0.12, 0.23, 0.12, 1)
shader_parameter/foam_color = Color(0.5, 0.56, 0.44, 1)
shader_parameter/depth_full = 0.7
shader_parameter/alpha_shallow = 0.72
shader_parameter/alpha_deep = 0.985
shader_parameter/ripple_shade = 0.9
shader_parameter/color_steps = 6.0
shader_parameter/sun_bands = 2.0
shader_parameter/sun_wrap = 0.5
shader_parameter/fresnel_power = 4.0
shader_parameter/fresnel_gain = 0.9
shader_parameter/reflect_gain = 0.8
shader_parameter/glint_power = 90.0
shader_parameter/glint_gain = 0.6
shader_parameter/flow_foam = 0.18
shader_parameter/still_foam = 0.05
shader_parameter/shore_foam_start = 0.93
shader_parameter/shore_foam_cover = 0.3
shader_parameter/foam_rate = 4.0
shader_parameter/underside_alpha = 0.6
shader_parameter/fog_enabled = true
shader_parameter/fog_color = Color(0.3, 0.3, 0.3, 1)
shader_parameter/fog_top = -170.0
shader_parameter/fog_bottom = -320.0
shader_parameter/fog_curve = 2.2
shader_parameter/fog_opacity_gain = 1.6
shader_parameter/fog_distance_start = 850.0
shader_parameter/fog_distance_density = 0.0012
shader_parameter/fog_distance_power = 2.0
