[gd_resource type="ShaderMaterial" load_steps=2 format=3]
;
; ISLAND 003's GIANT TREES: MAT_veg_billboard_w3.tres (island 001's trees) for
; the user's giant firs, twice their height (`tint` is island 001's: the
; art is painted darker than island 001's firs already). Three changes, all for
; the size:
;   * THE NEAR FADE CLEARS A BIG SPACE ROUND YOU, A WHOLE TREE AT A TIME: a fir
;     whose foot is inside 12 m of the eye is gone, trunk and crown together, and
;     one past 20 m is solid (the user, on foot: "make trees and other large veg
;     disappear much much farther away from player" — "much bigger space" — and
;     "trees etc need to fully fade out as a whole unit not just within a
;     spherical radius"). Measured once per tree, as every plant now is, so the
;     whole quad dithers together, as the bushes do. (It was a
;     sphere round the eye that bit the trunks away and left the canopy hanging
;     over you; before that, 1 m and 2.5 m.)
;   * LESS SWAY: a trunk that wide does not bend at the top as a sapling does.
;   * DRAWN THREE TIMES AS FAR as island 001's trees fade (900..1260 m for its
;     300..420), at the user's asking ("increase the distance at which bushes and
;     trees are culled by like 3x"). At the ground the fog has everything long
;     before (ForestFog, about 200 m to nothing); from the air, where it thins
;     with height, the wood now runs on out to the coast instead of stopping.

[ext_resource type="Shader" path="res://shaders/SHADER_veg_billboard.gdshader" id="1_veg"]

[resource]
render_priority = 0
shader = ExtResource("1_veg")
shader_parameter/alpha_scissor = 0.4
shader_parameter/tint = Color(0.62, 0.62, 0.62, 1)
shader_parameter/flip_variants = true
shader_parameter/wind_strength = 0.02
shader_parameter/wind_speed = 0.55
shader_parameter/wind_scale = 17.0
shader_parameter/near_gone = 12.0
shader_parameter/near_solid = 20.0
shader_parameter/far_start = 900.0
shader_parameter/far_end = 1260.0
shader_parameter/fog_enabled = true
shader_parameter/fog_color = Color(0.3, 0.3, 0.3, 1)
shader_parameter/fog_distance_start = 850.0
shader_parameter/fog_distance_density = 0.0012
shader_parameter/fog_distance_power = 2.0
